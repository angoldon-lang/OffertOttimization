# Copia in .env (non versionato) e adatta. Tutte le variabili sono facoltative.
AD_HOST=127.0.0.1            # lasciare su localhost: l'app non ha autenticazione
AD_PORT=8000
AD_PROFILES_DIR=./profiles   # cartella dei profili aziendali JSON (vedi profiles/ad_consulting_demo.json)

# Calcoli
AD_ROUNDING=half_up          # half_up | half_even | down | up
AD_DECIMALS=2
AD_MARGIN_THRESHOLD=20       # % sotto cui il margine è evidenziato (il profilo può sovrascriverla con margin_threshold_pct)
AD_VAT_DEFAULT=22            # solo valore proposto, sempre modificabile

AD_MAX_UPLOAD_MB=25

# Servizio AI esterno (OPZIONALE, disattivato di default). Con provider "none" tutto resta in locale.
# Se attivo, per ogni revisione serve il consenso dell'utente e viene inviato SOLO il testo dei paragrafi del corpo
# dell'offerta (non tabelle, non quotazioni fornitore, non costi interni, non margini).
AD_LLM_PROVIDER=none         # none | anthropic
AD_LLM_API_KEY=
AD_LLM_MODEL=claude-sonnet-5-5
AD_LLM_BASE_URL=https://api.anthropic.com
